{
  "name": "price-tracker-backend",
  "version": "1.0.0",
  "description": "INE Product Price Tracker Backend and Playwright Scraper",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape:headed": "tsx src/cli/headed-runner.ts",
    "scrape:headed:dry": "tsx src/cli/headed-runner.ts --dry-run",
    "scrape:headless": "tsx src/cli/headed-runner.ts --headless",
    "snapshot:sync": "tsx src/cli/sync-catalog.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "playwright": "^1.50.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
